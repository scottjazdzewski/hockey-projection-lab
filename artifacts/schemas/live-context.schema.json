{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"live-context.schema.json",
  "title":"Hockey Lab Live Pregame Context",
  "type":"object",
  "required":["schema_version","date","generated_at","provider","games"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "date":{"type":"string"},
    "generated_at":{"type":"string","format":"date-time"},
    "provider":{
      "type":"object",
      "required":["name","access_mode","goalie_url","lineup_url_pattern"],
      "properties":{
        "name":{"type":"string"},
        "access_mode":{"type":"string"},
        "goalie_url":{"type":"string"},
        "lineup_url_pattern":{"type":"string"},
        "robots_policy":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "games":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["game_id","away","home"],
        "properties":{
          "game_id":{"type":["integer","string"]},
          "away":{"$ref":"#/$defs/teamContext"},
          "home":{"$ref":"#/$defs/teamContext"}
        },
        "additionalProperties":false
      }
    }
  },
  "$defs":{
    "goalie":{
      "type":"object",
      "required":["name","status","observed_at"],
      "properties":{
        "name":{"type":["string","null"]},
        "status":{"enum":["UNKNOWN","PROJECTED","CONFIRMED"]},
        "observed_at":{"type":"string","format":"date-time"},
        "source_timestamp":{"type":["string","null"]},
        "source_name":{"type":["string","null"]},
        "source_url":{"type":["string","null"]},
        "player_id":{"type":["integer","string","null"]}
      },
      "additionalProperties":false
    },
    "lineup":{
      "type":"object",
      "required":["status","observed_at","updated_at","source_name","source_url","groups","injuries"],
      "properties":{
        "status":{"enum":["UNKNOWN","PROJECTED"]},
        "observed_at":{"type":"string","format":"date-time"},
        "updated_at":{"type":["string","null"]},
        "source_name":{"type":["string","null"]},
        "source_url":{"type":["string","null"]},
        "groups":{
          "type":"object",
          "additionalProperties":{
            "type":"array",
            "items":{
              "type":"object",
              "required":["name","position"],
              "properties":{
                "name":{"type":"string"},
                "position":{"type":["string","null"]},
                "player_id":{"type":["integer","string","null"]}
              },
              "additionalProperties":false
            }
          }
        },
        "injuries":{
          "type":"array",
          "items":{
            "type":"object",
            "required":["name","injury_status","game_time_decision"],
            "properties":{
              "name":{"type":"string"},
              "injury_status":{"type":["string","null"]},
              "game_time_decision":{"type":"boolean"},
              "player_id":{"type":["integer","string","null"]}
            },
            "additionalProperties":false
          }
        }
      },
      "additionalProperties":false
    },
    "teamContext":{
      "type":"object",
      "required":["abbr","goalie","lineup"],
      "properties":{
        "abbr":{"type":"string","minLength":2,"maxLength":3},
        "goalie":{"$ref":"#/$defs/goalie"},
        "lineup":{"$ref":"#/$defs/lineup"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
