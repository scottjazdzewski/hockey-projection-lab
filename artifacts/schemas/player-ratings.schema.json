{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"player-ratings.schema.json",
  "title":"Hockey Lab Player Ratings",
  "type":"object",
  "required":["schema_version","generated_at","model","players"],
  "properties":{
    "schema_version":{"const":"1.1"},
    "generated_at":{"type":"string","format":"date-time"},
    "model":{
      "type":"object",
      "required":["model_id","version","status"],
      "properties":{
        "model_id":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "status":{"enum":["RESEARCH","CANDIDATE","PROMOTED"]},
        "trained_through":{"type":["string","null"]}
      },
      "additionalProperties":true
    },
    "players":{"type":"array","items":{"type":"object","required":["player_id","name","team_abbr","position"],"properties":{
      "player_id":{"type":["integer","string"]},"name":{"type":"string","minLength":1},"team_abbr":{"type":"string","minLength":2,"maxLength":3},"position":{"type":"string","minLength":1},
      "overall":{"type":["number","null"]},"offense":{"type":["number","null"]},"defense":{"type":["number","null"]},
      "shot_generation":{"type":["number","null"]},"finishing":{"type":["number","null"]},"playmaking":{"type":["number","null"]},
      "usage":{"type":["number","null"]},"as_of":{"type":["string","null"]}
    },"additionalProperties":true}}
  },
  "additionalProperties":false
}