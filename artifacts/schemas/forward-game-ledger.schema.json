{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hockey-lab.local/schemas/forward-game-ledger.schema.json",
  "title": "Hockey Lab Forward Game Ledger Record",
  "type": "object",
  "required": ["schema_version","game_id","game_date","start_time_et","matchup","frozen_at","forecast","result"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "game_id": {"type":["integer","string"]},
    "game_date": {"type":"string"},
    "start_time_et": {"type":"string"},
    "matchup": {"type":"object"},
    "frozen_at": {"type":"string"},
    "minutes_before_start": {"type":"number"},
    "forecast": {
      "type":"object",
      "required":["model","away","home","goalie_context","market_benchmark"],
      "properties":{
        "probability_components":{
          "type":"object",
          "required":["team_only","goalie_adjustment_status","goalie_adjustment"],
          "properties":{
            "team_only":{
              "type":"object",
              "required":["away_win_probability","home_win_probability"],
              "properties":{
                "away_win_probability":{"type":["number","null"],"minimum":0,"maximum":1},
                "home_win_probability":{"type":["number","null"],"minimum":0,"maximum":1}
              }
            },
            "goalie_adjustment_status":{"type":["string","null"]},
            "goalie_adjustment":{"type":["object","null"],"additionalProperties":true}
          }
        },
        "model_flags":{"type":"array","items":{"type":"string"}},
        "market_benchmark":{
          "type":"object",
          "required":["status","source","captured_at","capture_requested_at","minimum_books_required","book_count","total_book_count","books"],
          "properties":{
            "status":{"enum":["NOT_CAPTURED","CONSENSUS","LIMITED_CONSENSUS","SINGLE_BOOK","RETRYABLE_UNAVAILABLE"]},
            "source":{"type":["string","null"]},
            "captured_at":{"type":["string","null"]},
            "capture_requested_at":{"type":["string","null"]},
            "minimum_books_required":{"type":"integer","minimum":3},
            "book_count":{"type":"integer","minimum":0},
            "total_book_count":{"type":"integer","minimum":0},
            "away_implied_probability":{"type":["number","null"],"minimum":0,"maximum":1},
            "home_implied_probability":{"type":["number","null"],"minimum":0,"maximum":1},
            "home_probability_min":{"type":["number","null"],"minimum":0,"maximum":1},
            "home_probability_max":{"type":["number","null"],"minimum":0,"maximum":1},
            "home_probability_std":{"type":["number","null"],"minimum":0},
            "earliest_odds_timestamp":{"type":["string","null"]},
            "latest_odds_timestamp":{"type":["string","null"]},
            "books":{"type":"array","items":{"type":"object"}}
          }
        }
      }
    },
    "result": {
      "type":"object",
      "required":["status"],
      "properties":{"status":{"enum":["OPEN","FINAL"]}}
    },
    "evaluation": {"type":["object","null"]}
  }
}
