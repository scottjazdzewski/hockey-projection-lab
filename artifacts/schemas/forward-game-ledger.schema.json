{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hockey-lab.local/schemas/forward-game-ledger.schema.json",
  "title": "Hockey Lab Forward Game Ledger Record",
  "type": "object",
  "required": ["schema_version","game_id","game_date","start_time_et","matchup","frozen_at","forecast","result"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "game_id": {"type":["integer","string"]},
    "game_date": {"type":"string"},
    "start_time_et": {"type":"string"},
    "matchup": {"type":"object"},
    "frozen_at": {"type":"string"},
    "minutes_before_start": {"type":"number"},
    "forecast": {
      "type":"object",
      "required":["model","away","home","goalie_context","market_benchmark"],
      "properties":{
        "probability_components":{
          "type":"object",
          "required":["team_only"],
          "properties":{
            "team_only":{
              "type":"object",
              "required":["away_win_probability","home_win_probability"],
              "properties":{
                "away_win_probability":{"type":["number","null"],"minimum":0,"maximum":1},
                "home_win_probability":{"type":["number","null"],"minimum":0,"maximum":1}
              }
            }
          }
        }
      }
    },
    "result": {
      "type":"object",
      "required":["status"],
      "properties":{"status":{"enum":["OPEN","FINAL"]}}
    },
    "evaluation": {
      "type":["object","null"],
      "properties":{
        "team_only_brier":{"type":["number","null"],"minimum":0},
        "team_only_log_loss":{"type":["number","null"],"minimum":0},
        "goalie_layer_delta_brier":{"type":["number","null"]},
        "goalie_layer_delta_log_loss":{"type":["number","null"]}
      }
    }
  }
}
