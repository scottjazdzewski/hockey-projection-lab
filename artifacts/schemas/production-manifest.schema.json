{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"production-manifest.schema.json",
  "title":"Hockey Lab Production Manifest",
  "type":"object",
  "required":["schema_version","updated_at","surfaces"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "updated_at":{"type":"string","format":"date-time"},
    "surfaces":{
      "type":"object",
      "additionalProperties":{
        "type":"object",
        "required":["file","schema","state"],
        "properties":{
          "file":{"type":"string"},
          "schema":{"type":"string"},
          "state":{"enum":["EMPTY","READY","WITHHELD"]},
          "owner":{"type":"string"},
          "model_id":{"type":["string","null"]},
          "model_version":{"type":["string","null"]},
          "max_age_minutes":{"type":["integer","null"],"minimum":1}
        },
        "additionalProperties":false
      }
    }
  },
  "additionalProperties":false
}