{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"team-ratings.schema.json",
  "title":"Hockey Lab Team Ratings",
  "type":"object",
  "required":["schema_version","generated_at","model","teams"],
  "properties":{
    "schema_version":{"const":"1.1"},
    "generated_at":{"type":"string","format":"date-time"},
    "model":{
      "type":"object",
      "required":["model_id","version","status"],
      "properties":{
        "model_id":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "status":{"enum":["RESEARCH","CANDIDATE","PROMOTED"]},
        "trained_through":{"type":["string","null"]}
      },
      "additionalProperties":true
    },
    "teams":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["abbr","name"],
        "properties":{
          "abbr":{"type":"string","minLength":2,"maxLength":3},
          "name":{"type":"string","minLength":1},
          "overall":{"type":["number","null"]},
          "offense":{"type":["number","null"]},
          "defense":{"type":["number","null"]},
          "five_on_five":{"type":["number","null"]},
          "power_play":{"type":["number","null"]},
          "penalty_kill":{"type":["number","null"]},
          "goaltending":{"type":["number","null"]},
          "form":{"type":["number","null"]},
          "as_of":{"type":["string","null"]}
        },
        "additionalProperties":true
      }
    }
  },
  "additionalProperties":false
}